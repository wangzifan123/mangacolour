<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_api"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#888888"
            android:text="先打开 local-dream 并加载一个模型，否则连不上。PC 端调试请先 adb forward tcp:8081 tcp:8081" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPick"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_pick" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_stop" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_save" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="未载入" />

        <!-- GAN 路线入口：只做跳转，不影响本页任何逻辑 -->
        <Button
            android:id="@+id/btnGanEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_gan_entry" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:text="就绪" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:background="#22000000"
            android:contentDescription="preview"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="加速（可大幅缩短耗时）" />

        <CheckBox
            android:id="@+id/cbFast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="快模式：8 步 / CFG 1（需 DMD2 或 LCM 模型）" />

        <CheckBox
            android:id="@+id/cbLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="限制长边 1024（切块数约减 60%，最后放大回原尺寸）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:text="参数" />

        <TextView android:id="@+id/tvDenoise" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbDenoise" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tvTile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbTile" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tvOverlap" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbOverlap" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tvSteps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbSteps" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tvCfg" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbCfg" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tvLine" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbLine" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/tvThreshold" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />
        <SeekBar android:id="@+id/sbThreshold" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
